{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "module": "commonjs",
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@9nau/types": ["packages/types/src/index.ts"],
      "@9nau/core": ["packages/core/src/index.ts"],
      "@9nau/ui": ["packages/ui/src/index.ts"],
      "@9nau/ui/*": ["packages/ui/src/*"],
      "@/components/*": ["apps/app/src/components/*"],
      "@/lib/*": ["apps/app/src/lib/*"],
      "@/providers/*": ["apps/app/src/providers/*"],
      "@/hooks/*": ["apps/app/src/hooks/*"]
    }
  },
  "exclude": ["node_modules"]
}
