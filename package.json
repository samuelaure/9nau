{
  "name": "9naŭ",
  "version": "1.0.0",
  "description": "The 9naŭ platform for life and business growth.",
  "private": true,
  "scripts": {
    "build": "tsc --build",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "eslint \"{apps,packages}/**/*.{ts,tsx}\" --fix",
    "dev:api": "pnpm --filter api run start:dev",
    "dev:web": "pnpm --filter web run dev",
    "test:all": "jest --projects apps/api apps/web packages/core packages/ui",
    "test:unit": "jest --projects apps/web packages/core packages/ui",
    "test:e2e": "cypress run --project ./apps/web"
  },
  "author": "Samuel Aure",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/cli": "^11.0.7",
    "@types/node": "^24.1.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.0.0-alpha.44",
    "cypress": "^13.13.1",
    "jest": "^29.7.0"
  }
}
