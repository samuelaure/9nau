{
  "name": "9naŭ",
  "version": "1.0.0",
  "private": true,
  "description": "The 9naŭ platform for life and business growth.",
  "license": "UNLICENSED",
  "author": "Samuel Aure",
  "scripts": {
    "build": "pnpm --stream -r build",
    "dev:api": "pnpm --filter api run start:dev",
    "dev:web": "pnpm --filter web run dev",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "eslint \"{apps,packages}/**/*.{ts,tsx}\" --fix",
    "test:all": "jest --projects apps/api apps/web packages/core packages/ui --runInBand",
    "test:e2e": "cypress run",
    "test:unit": "jest --projects apps/web packages/core packages/ui --runInBand",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/cli": "^11.0.7",
    "@types/node": "^24.1.0",
    "cypress": "^13.13.1",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.0.0-alpha.44"
  },
  "packageManager": "pnpm@10.13.1"
}
