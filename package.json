  "private": true,
  "description": "The 9naŭ platform for life and business growth.",
  "license": "UNLICENSED",
  "author": "Samuel Aure",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
