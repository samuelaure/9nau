    "cypress": "^13.13.1",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.6.2",
    "standard-version": "^9.5.0",
    "turbo": "^2.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.0.0-alpha.44"
  },
  "packageManager": "pnpm@10.14.0"
