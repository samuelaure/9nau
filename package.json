    "prod:infra": "docker compose --env-file .env up -d",
    "release": "standard-version"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/cli": "^11.0.7",
    "@types/node": "^24.1.0",
